<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 听书前台服务与通知（见 PRD F-06） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 听书输出路由（V1.3）：setSpeakerphoneOn/setMode 受此普通权限门控，缺权限为静默 no-op；
         普通权限安装即授予、无运行时弹窗，与本应用零网络/零数据收集原则不冲突 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 旧设备(≤API 32)遍历公共目录；新设备统一走 SAF，无需权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      合规红线：本应用（offline 变体）不声明 INTERNET 权限，全离线运行。
      禁止添加 GMS / Firebase / 任何在线服务依赖（docs/ARCHITECTURE_ANDROID.md D2）。
    -->

    <!-- Android 11+ 包可见性：允许发现系统 TTS 引擎（eSpeak NG / RHVoice / 厂商引擎） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
    </queries>

    <application
        android:name=".YYXApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YYXReader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收第三方「分享 / 打开方式」的 TXT / EPUB（F-01-09） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>

        <!-- 听书前台服务（F-06）：通知栏媒体卡片 + 锁屏/耳机/蓝牙控制 -->
        <service
            android:name=".service.tts.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
